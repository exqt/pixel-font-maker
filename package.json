{
  "name": "pixel-font-maker",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "vite build && electron-builder"
  },
  "dependencies": {
    "fonteditor-core": "exqt/fonteditor-core",
    "konva": "^9.3.22",
    "mobx": "^6.3.0",
    "mobx-react-lite": "^4.1.1",
    "opentype.js": "^1.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-konva": "^18.2.14",
    "styled-components": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.exqt.pixel-font-maker",
    "productName": "Pixel Font Maker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
